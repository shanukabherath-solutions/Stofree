
# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing and coverage
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Python tooling caches
.mypy_cache/
.ruff_cache/

# ==========================================
# IDE and editor
# ==========================================
.idea/
.vscode/

# Local-only agent/tool cache (if applicable)
# Do not ignore the actual tools/ source directory.
/.tools/

# ==========================================
# Logs and temporary files
# ==========================================
*.log
*.tmp
*.bak

# ==========================================
# Operating system files
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# Build output (do not commit generated binaries)
# ==========================================
/build/
/dist/
/installer-output/

# Generated Inno Setup wizard artwork
/installer/assets/

# Keep packaging/Stofree.spec tracked.
# PyInstaller spec files are source configuration,
# not disposable build output.
